}
@keyframes scaleIn-045d88fd {
from {
    transform: scaleX(0);
}
to {
    transform: scaleX(1);
}
}
.waterfall-wrapper.data-v-045d88fd {
  padding-bottom: env(safe-area-inset-bottom);
  /* 适配 iPhone 底部安全区 */
}