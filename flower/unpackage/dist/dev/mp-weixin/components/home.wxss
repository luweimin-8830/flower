  overflow: hidden;
}
.plant-image.data-v-045d88fd {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: opacity 0.4s ease-in-out;
}
.plant-image.show.data-v-045d88fd {
  opacity: 1;
}
.plant-info.data-v-045d88fd {
  padding: 8px;
}
.plant-name.data-v-045d88fd {
  font-size: 14px;
  color: #333;
  font-weight: bold;
}

/* 空状态样式 */
.empty-wrapper.data-v-045d88fd {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon.data-v-045d88fd {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
