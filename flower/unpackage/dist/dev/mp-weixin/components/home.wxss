/* 水平间距 */
/* 水平间距 */
/* 1. 页面容器：占满全屏，垂直排列 */
.home-container.data-v-045d88fd {
  height: 100vh;
  /* 关键：锁定高度 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* 禁止整个页面拖动 */
  box-sizing: border-box;
  background-color: var(--bg-color);
  /* 建议加个背景色，防止列表滚动到底部露白 */
}

/* 2. 头部固定区域组 */
.fixed-header-group.data-v-045d88fd {
  flex-shrink: 0;
  /* 禁止压缩 */
  z-index: 10;
  background-color: var(--bg-color);
  /* 必须给背景色，否则列表滚动时会透过文字看到下面 */
  /* 如果你的设计是背景图通铺，这里可以用 transparent，但要注意视觉重叠 */
}
.edit-mode-header.data-v-045d88fd {
  width: 100%;
  padding: 0 10px;
}
.clean-btn.data-v-045d88fd,
.save-btn-rect.data-v-045d88fd {
  width: 100%;
  height: 74rpx;
  background: var(--bg-btn-color);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 1px solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-color);
}
.clean-btn.data-v-045d88fd:active,
.save-btn-rect.data-v-045d88fd:active {
  transform: scale(0.92) translateY(2px);
}
.save-btn-rect.data-v-045d88fd {
  color: var(--primary-color);
  font-weight: bold;
}
.action-selection-bar.data-v-045d88fd {
  display: flex;
  align-items: center;
  padding: 0 0 0 10px;
  height: 140rpx;
}
.select-all-wrapper.data-v-045d88fd {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}
.select-all-wrapper .select-all-text.data-v-045d88fd {
  font-size: 10px;
  color: var(--primary-color);
  margin-top: 4rpx;
}
.action-scroll-view.data-v-045d88fd {
  flex: 1;
  width: 0;
  white-space: nowrap;
  height: 100%;
}
.action-list.data-v-045d88fd {
  display: inline-flex;
  align-items: center;
  padding-right: 60rpx;
  height: 100%;
}
.action-item.data-v-045d88fd {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  width: 120rpx;
  height: 120rpx;
  background: var(--bg-btn-color);
  border-radius: 24rpx;
  transition: all 0.2s;
  flex-shrink: 0;
}
.action-item.active.data-v-045d88fd {
  background: var(--primary-color);
}
.action-item.active .action-name.data-v-045d88fd {
  color: #fff;
}
.action-item .action-name.data-v-045d88fd {
  font-size: 11px;
  color: var(--text-sub);
  margin-top: 8rpx;
  width: 100%;
  text-align: center;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
}
.checkbox-wrapper.data-v-045d88fd {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 5;
  background: var(--bg-btn-color);
  border-radius: 50%;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 3. 滚动区域：自动填满剩余空间 */
.content-scroll-view.data-v-045d88fd {
  flex: 1;
  /* 占据剩余高度 */
  height: 0;
  /* 🌟 关键：强制触发 Flex 计算，防止 scroll-view 被内容撑开导致失效 */
  overflow: hidden;
  margin-bottom: 160rpx;
}
.waterfall-wrapper.data-v-045d88fd {
  padding-bottom: env(safe-area-inset-bottom);
  /* 适配 iPhone 底部安全区 */
}
.family-select.data-v-045d88fd {
  position: fixed;
  z-index: 999;
  /* --- 核心毛玻璃样式 --- */
  background-color: var(--bg-btn-color);
  /* 半透明白底 */
  backdrop-filter: blur(10px);
  /* 模糊背景 */
  -webkit-backdrop-filter: blur(10px);
  /* 兼容 iOS */
  border-radius: 20px;
  border: 1px solid var(--border-color);
  /* 极细的浅色边框 */
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  /* 增强阴影效果 */
  /* 布局与过渡 */
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 12px;
  gap: 6px;
  transition: all 0.3s ease;
  box-sizing: border-box;
  /* 确保边框不撑大尺寸 */
  /* 交互状态 */
}
.family-select.data-v-045d88fd:active, .family-select.selecting.data-v-045d88fd {
  transform: scale(0.95);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
}
.family-select.selecting .family-select-icon.data-v-045d88fd {
  transform: scale(0.9);
  opacity: 1;
}
.family-select-icon.data-v-045d88fd {
  flex-shrink: 0;
  opacity: 0.8;
  transition: opacity 0.2s;
}
.family-select-icon uni-icons.data-v-045d88fd {
  font-size: 16px;
}

/* 微信 picker 样式调整 */
.custom-select.data-v-045d88fd {
  flex: 1;
  height: 100%;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
}
.family-name-wrapper.data-v-045d88fd {
  display: flex;
  align-items: center;
  flex-direction: row;
}
.family-select-text.data-v-045d88fd {
  font-size: 14px;
  color: #333;
  opacity: 0.9;
  font-weight: 500;
}
@media (prefers-color-scheme: dark) {
.family-select-text.data-v-045d88fd {
    color: var(--primary-color);
}
.family-select-icon.data-v-045d88fd .uni-icons {
    color: var(--primary-color) !important;
}
}
.header-action-container.data-v-045d88fd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  /* 左右留白 */
  margin-bottom: 5px;
  margin-top: 10px;
  /* 和下方 Tag 保持一点距离 */
}
.search-box-wrapper.data-v-045d88fd {
  /* 核心：搜索框占 82% (稍微多一点看起来更协调，留 18% 给按钮) */
  width: 86%;
}
.add-btn.data-v-045d88fd {
  width: 74rpx;
  /* 稍微加大一点点，更易点击 */
  height: 74rpx;
  /* 1. 微弱的线性渐变，模拟光照（上亮下暗） */
  background: rgba(255, 255, 255, 0.55);
  /* 如果不支持渐变回退到纯色 */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  /* 3. 增加一点边框让轮廓更清晰 */
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.add-btn.data-v-045d88fd:active {
  transform: scale(0.92) translateY(2px);
  /* 点击时下沉 */
}
.data-v-045d88fd .uni-searchbar {
  padding: 10px 0 !important;
  /* 去掉左右默认 padding */
}
@media (prefers-color-scheme: dark) {
.data-v-045d88fd .uni-searchbar .uni-searchbar__box-search-input {
    color: #f5f5f5 !important;
}
.data-v-045d88fd .uni-searchbar .uni-searchbar__text-placeholder {
    color: rgba(245, 245, 245, 0.7) !important;
}
}

/* 这是一个深度选择器，用于去除 uni-data-select 自带的边框，使其融入毛玻璃按钮 */
.data-v-045d88fd .uni-select {
  border: none !important;
  background-color: transparent !important;
  padding: 0 !important;
  height: 100%;
  justify-content: center;
}
.data-v-045d88fd .uni-select__input-text {
  font-size: 12px;
  /* 字体改小一点以适应按钮 */
  color: #333;
}
.data-v-045d88fd .uni-select__selector-item {
  /* 这一行是为了覆盖原生样式，确保我们自定义的 slot 充满整行 */
  padding: 0 !important;
}
.tag-scroll-container.data-v-045d88fd {
  width: 100%;
  background-color: transparent;
  padding: 5px 0;
}
.tag-scroll-view.data-v-045d88fd {
  width: 100%;
  white-space: nowrap;
  /* 关键：禁止换行 */
}
.tag-flex-box.data-v-045d88fd {
  display: flex;
  align-items: center;
  padding: 0 40rpx 0 20rpx;
  position: relative;
}
.tag-item.data-v-045d88fd {
  position: relative;
  /* 为了定位下划线 */
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px;
  margin-right: 10px;
  font-size: 16px;
  color: #666;
  transition: all 0.3s;
}
@media (prefers-color-scheme: dark) {
.tag-item.data-v-045d88fd {
    color: #f5f5f5;
}
}
.tag-item.active.data-v-045d88fd {
  color: #6B8857;
  /* 选中颜色 */
  font-weight: bold;
  font-size: 20px;
  /* 选中稍微变大 */
}
@media (prefers-color-scheme: dark) {
.tag-item.active.data-v-045d88fd {
    color: #FAF2CB;
}
}

/* 下划线动画样式 */
.slider-bar.data-v-045d88fd {
  position: absolute;
  bottom: 8px;
  /* 距离底部的位置 */
  left: 0;
  /* 初始位置，由 JS 控制 translateX */
  height: 3px;
  background-color: #6B8857;
  /* 下划线颜色 */
  border-radius: 2px;
  /* 动画配置 */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  /* width 和 transform 都会平滑过渡 */
  z-index: 1;
  /* 确保在文字下方或上方 */
  pointer-events: none;
  /* 不影响点击 */
}
@media (prefers-color-scheme: dark) {
.slider-bar.data-v-045d88fd {
    background-color: #FAF2CB;
}
}
.active-line.data-v-045d88fd {
  position: absolute;
  bottom: 0;
  width: 20px;
  /* 下划线宽度 */
  height: 3px;
  background-color: #6B8857;
  border-radius: 2px;
  animation: scaleIn-045d88fd 0.2s ease-out;
}
.plant-card.data-v-045d88fd {
  position: relative;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}
.card-delete-btn.data-v-045d88fd {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 10;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  transition: all 0.2s;
}
.card-delete-btn.data-v-045d88fd:active {
  transform: scale(0.9);
  background: #fff;
}
.image-wrapper.data-v-045d88fd {
  position: relative;
  width: 100%;
  height: 0;
  /* 背景色作为占位时的颜色 */
