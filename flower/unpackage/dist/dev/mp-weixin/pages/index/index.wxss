/* 水平间距 */
/* 水平间距 */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
}
.page .custom-tabbar-page {
  width: 100%;
  height: 0;
}
.pan-tabbar {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100vw;
  min-height: 100rpx;
  opacity: 0.55;
}
.safe-area-inset-bottom {
  opacity: 0.55;
  background-color: #fff;
  padding-bottom: calc(constant(safe-area-inset-bottom));
  padding-bottom: calc(env(safe-area-inset-bottom));
}
.liquid-box {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100vw;
  height: 100rpx;
  overflow: hidden;
  opacity: 0.55;
}
.liquid {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
}
.liquid .liquid-str01 {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  transition: height 0.3s cubic-bezier(0.333, 1.01, 0.32, 1.275), width 0.3s cubic-bezier(0.133, 1.01, 0.32, 1.275);
}
.liquid .liquid-str01 .image- {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  height: calc(100% + 20rpx);
  transform-origin: bottom center;
  z-index: 1;
}
.liquid .liquid-str01::after {
  position: absolute;
  left: -100vw;
  top: 0;
  content: "";
  width: 100vw;
  height: 100%;
  background-color: #fff;
}
.liquid .liquid-str01::before {
  position: absolute;
  right: -100vw;
  top: 0;
  content: "";
  width: 100vw;
  height: 100rpx;
  background-color: #fff;
}
.liquid .liquid_str01 {
  width: 200%;
  height: 0rpx;
}
.liquid .liquid-str02 {
  width: 100%;
  height: 0rpx;
  background-color: #fff;
}
.liquid .liquid-str02::after {
  position: absolute;
  left: -100vw;
  top: 0;
  content: "";
  width: 100vw;
  height: 100rpx;
  background-color: #fff;
}
.liquid .liquid-str02::before {
  position: absolute;
  right: -100vw;
  top: 0;
  content: "";
  width: 100vw;
  height: 100rpx;
  background-color: #fff;
}
.ball {
  position: absolute;
  z-index: 3;
  top: -16px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-image: linear-gradient(220deg, #BC3823, #BC3823, rgba(105, 55, 248, 0.3));
  transition: all 0.6s;
}
.ball_ {
  animation: moveUpDownBall 0.6s ease-in-out;
}
.pan-tabbar-list {
  box-sizing: border-box;
  padding: 0 20px;
  position: relative;
  z-index: 3;
  width: 100%;
  height: 100rpx;
}
.pan-tabbar-list .pan-tabbar-item {
  position: relative;
  width: 40px;
  height: 100%;
}
.pan-tabbar-list .pan-tabbar-item .pan-tabbar-item-icon {
  position: absolute;
  top: 10px;
  left: 5px;
  width: 30px;
  height: 30px;
  transition: all 0.6s ease-in-out;
}
.pan-tabbar-list .pan-tabbar-item .pan-tabbar-item-icon-off {
  opacity: 1;
}
.pan-tabbar-list .pan-tabbar-item .pan-tabbar-item-icon-on {
  opacity: 0;
}
.pan-tabbar-list .pan_tabbar_item .pan-tabbar-item-icon {
  top: -10px;
}
.pan-tabbar-list .pan_tabbar_item .pan-tabbar-item-icon-off {
  opacity: 0;
}
.pan-tabbar-list .pan_tabbar_item .pan-tabbar-item-icon-on {
  opacity: 1;
}

/* 定义上下移动的动画 */
@keyframes moveUpDownBall {
0% {
    transform: translateY(0);
}
40% {
    transform: translateY(-60px);
}
80% {
    transform: translateY(6px);
}
100% {
    transform: translateY(0);
}
}
.flex_r {
  display: flex;
  flex-direction: row;
}
.flex_c {
  display: flex;
  flex-direction: column;
}
.fj_b {
  justify-content: space-between;
}
.fj_a {
  justify-content: space-around;
}
.fj_c {
  justify-content: center;
}
.fa_c {
  align-items: center;
}
.flex_c_c {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.flex_r_c {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.flex1 {
  flex: 1;
}
.wh_100 {
  width: 100%;
  height: 100%;
}
.z_index2 {
  position: relative;
  z-index: 2;
}
.hover_class {
  position: relative;
  overflow: hidden;
}
.hover_class::after {
  position: absolute;
  z-index: 2;
  content: "";
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.1);
}
.rotate_45 {
  transform: rotate(45deg);
}
.rotate_90 {
  transform: rotate(90deg);
}
.rotate_180 {
  transform: rotate(180deg);
}